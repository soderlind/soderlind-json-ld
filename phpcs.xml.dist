<?xml version="1.0"?>
<ruleset name="Soderlind JSON-LD">
	<description>WordPress Coding Standards for Soderlind JSON-LD plugin</description>

	<file>./soderlind-json-ld.php</file>
	<file>./src</file>
	<file>./uninstall.php</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="soderlind-json-ld"/>
			</property>
		</properties>
	</rule>
</ruleset>
